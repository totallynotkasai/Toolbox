<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Tuner and sound meter; requested at runtime when either opens. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Step counter: runtime permission on API 29+ (not needed for the sensor below that). -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Step counter: lets its persisted midnight/hourly snapshot jobs survive a reboot. Stopwatch: posts a running
         stopwatch's notification again after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Timer and Stopwatch: their notifications; asked for when either is first started (API 33+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Timer: the alarm that ends it fires on time even when the phone is asleep. USE_EXACT_ALARM is granted at
         install from API 33 and is meant for alarm and timer apps; API 31-32 need SCHEDULE_EXACT_ALARM instead. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- Timer: TimerAlarmService plays the alarm until it's stopped. systemExempted is the type Android allows for
         continuing an alarm by apps that hold USE_EXACT_ALARM. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <!-- Soundscapes: SoundscapeService keeps playing with the screen off. Granted at install; nothing is asked. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Compass: approximate location, asked for when True north is turned on, to work out the magnetic declination
         offline. Only the declination is kept, never the location. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Every hardware feature is optional; each tool shows "not supported" instead. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Toolbox.Starting">
        <!-- Portrait only, by choice; MainActivity frees rotation while the Calculator is open. API 36 ignores the
             lock on screens 600dp and wider, so every screen still has to work in landscape. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Step counter: reads the hardware counter hourly and just after midnight (scheduled by StepScheduler). -->
        <service
            android:name=".tools.steps.StepSnapshotJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Timer: the alarm that ends it, and the buttons on its notification. -->
        <receiver
            android:name=".tools.timer.TimerReceiver"
            android:exported="false" />

        <!-- Timer: runs only while the alarm is ringing. -->
        <service
            android:name=".tools.timer.TimerAlarmService"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />

        <!-- Soundscapes: plays from Play until Stop, through its media notification's buttons too. -->
        <service
            android:name=".tools.soundscapes.SoundscapeService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Stopwatch: the buttons on its notification. -->
        <receiver
            android:name=".tools.stopwatch.StopwatchReceiver"
            android:exported="false" />

        <!-- Stopwatch: brings its notification back after a reboot. Exported so Android can deliver BOOT_COMPLETED,
             which only the system can send. -->
        <receiver
            android:name=".tools.stopwatch.StopwatchBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
