<?xml version="1.0" encoding="utf-8"?>
<!-- Backups and phone-to-phone transfers on Android 12 and later. The step counter's state holds counter values that
     only mean something on this phone and since its last boot, so restoring them would credit thousands of steps to
     one day. The stopwatch's is timed against this phone's clocks too, so a restored one would count from the day it
     was backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="steps.xml" />
        <exclude domain="sharedpref" path="stopwatch.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="steps.xml" />
        <exclude domain="sharedpref" path="stopwatch.xml" />
    </device-transfer>
</data-extraction-rules>
